/*
 * HypeDE — оформление оболочки в духе Chrome OS.
 *
 * Файл-шаблон: tools/gen-shell-css.py подставляет сюда цвета светлой и
 * тёмной схемы и пишет stylesheet-light.css и stylesheet-dark.css в папку
 * расширения. GNOME сам выбирает нужный файл по системной схеме.
 * Правьте этот шаблон, а не сгенерированные файлы.
 */

/* ------------------------------------------------------------------ */
/* Полка                                                               */
/* ------------------------------------------------------------------ */

/* Толщину полки, прозрачность фона и скругление «островка» задаёт
   style.js по настройкам — здесь только то, что от них не зависит. */
#panel.hypede-shelf {
  font-weight: normal;
  font-size: 10.5pt;
  color: @fg@;
  background-color: @shelf_bg@;
  box-shadow: none;
  transition-duration: 300ms;
}

/* В обзоре и на экране блокировки полка остаётся полупрозрачной подложкой */
#panel.hypede-shelf:overview {
  background-color: @shelf_bg_overview@;
  transition-duration: 300ms;
}

#panel.hypede-shelf #panelLeft,
#panel.hypede-shelf #panelRight {
  spacing: 4px;
  padding: 0 6px;
}

/* «Островок»: полка с отступом от края и скруглёнными углами */
#panel.hypede-shelf.floating {
  margin: 8px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.22);
  transition-duration: 300ms;
}

/* На экране блокировки у полки нет фона — только кнопки и трей */
#panel.hypede-shelf.locked {
  background-color: transparent;
  box-shadow: none;
}

/* Вертикальная полка (слева или справа) */
#panel.hypede-shelf.vertical #panelLeft,
#panel.hypede-shelf.vertical #panelRight {
  padding: 6px 0;
}
#panel.hypede-shelf.vertical .panel-button {
  margin: 2px 6px;
}
#panel.hypede-shelf.vertical .panel-button.hypede-launcher-button {
  margin: 4px 6px;
}
#panel.hypede-shelf.vertical .hypede-launcher-ring-bin {
  padding: 10px 0;
}
#panel.hypede-shelf.vertical .panel-status-indicators-box {
  padding: 10px 0;
  spacing: 8px;
}
#panel.hypede-shelf.vertical .hypede-tray-clock {
  padding-left: 0;
  padding-top: 4px;
  text-align: center;
  font-feature-settings: "tnum";
}
#panel.hypede-shelf.vertical .hypede-shelf-apps {
  padding: 4px 0;
}

#panel.hypede-shelf .panel-button {
  color: @fg@;
  font-weight: normal;
  border: none;
  border-radius: 999px;
  margin: 8px 0;
  box-shadow: none;
  background-color: transparent;
  -natural-hpadding: 12px;
  -minimum-hpadding: 8px;
  transition-duration: 150ms;
}
#panel.hypede-shelf .panel-button:hover,
#panel.hypede-shelf .panel-button:focus {
  box-shadow: none;
  background-color: @hover@;
}
#panel.hypede-shelf .panel-button:active,
#panel.hypede-shelf .panel-button:checked {
  box-shadow: none;
  background-color: @pressed@;
}

/* Кнопка лаунчера: кольцо, как в Chrome OS */
#panel.hypede-shelf .panel-button.hypede-launcher-button {
  margin: 8px 4px 8px 2px;
  -natural-hpadding: 10px;
  -minimum-hpadding: 10px;
}
.hypede-launcher-ring {
  width: 14px;
  height: 14px;
  border-radius: 999px;
  border: 2px solid @fg@;
}

/* Значки приложений */
.hypede-shelf-apps {
  spacing: 2px;
  padding: 0 4px;
}
.hypede-shelf-item {
  border-radius: 999px;
  transition-duration: 150ms;
}
.hypede-shelf-item:hover,
.hypede-shelf-item:focus {
  background-color: @hover@;
}
.hypede-shelf-item:checked {
  background-color: @pressed@;
}
.hypede-shelf-dot {
  width: 4px;
  height: 4px;
  margin-bottom: 1px;
  border-radius: 999px;
  background-color: @dot@;
  transition-duration: 200ms;
}
.hypede-shelf-item:active .hypede-shelf-dot {
  width: 12px;
  background-color: @fg@;
}

/* На вертикальной полке точка стоит сбоку */
.vertical .hypede-shelf-dot {
  margin-bottom: 0;
  margin-left: 1px;
  margin-right: 1px;
}
.vertical .hypede-shelf-item:active .hypede-shelf-dot {
  width: 4px;
  height: 12px;
}

/* Отметка запущенного приложения — чёрточкой */
.indicator-line .hypede-shelf-dot {
  width: 10px;
  height: 3px;
}
.indicator-line .hypede-shelf-item:active .hypede-shelf-dot {
  width: 20px;
}
.vertical.indicator-line .hypede-shelf-dot {
  width: 3px;
  height: 10px;
}
.vertical.indicator-line .hypede-shelf-item:active .hypede-shelf-dot {
  width: 3px;
  height: 20px;
}

/* …или без отметки */
.indicator-none .hypede-shelf-dot,
.indicator-none .hypede-shelf-item:active .hypede-shelf-dot {
  width: 0;
  height: 0;
}

/* Кнопки «Выключить» и «Перезагрузить» на экране блокировки */
.hypede-shelf-lock-actions {
  spacing: 8px;
  padding: 0 4px;
}
.hypede-shelf-lock-action {
  border-radius: 999px;
  padding: 8px 14px;
  color: @fg@;
  background-color: @tray_bg@;
  transition-duration: 150ms;
}
.hypede-shelf-lock-action:hover,
.hypede-shelf-lock-action:focus {
  background-color: @tray_hover@;
}
.hypede-shelf-lock-action-box {
  spacing: 8px;
}
.hypede-shelf-lock-action-icon {
  icon-size: 16px;
}
.vertical .hypede-shelf-lock-action {
  padding: 10px;
}

.hypede-shelf-tooltip {
  color: @tooltip_fg@;
  background-color: @tooltip_bg@;
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 10pt;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  transition-duration: 150ms;
}

/* Трей: дата и «пилюля» статуса со временем */
#panel.hypede-shelf .panel-button.hypede-tray-date-button,
#panel.hypede-shelf .panel-button.hypede-tray-status {
  background-color: @tray_bg@;
  -natural-hpadding: 14px;
  -minimum-hpadding: 10px;
  transition-duration: 150ms;
}
#panel.hypede-shelf .panel-button.hypede-tray-date-button:hover,
#panel.hypede-shelf .panel-button.hypede-tray-status:hover {
  background-color: @tray_hover@;
}
#panel.hypede-shelf .panel-button.hypede-tray-date-button:checked,
#panel.hypede-shelf .panel-button.hypede-tray-status:checked {
  background-color: @tray_checked@;
}
/* Родная подсветка кнопки даты рисуется на внутренней метке — убираем */
#panel.hypede-shelf .panel-button.clock-display .clock,
#panel.hypede-shelf .panel-button.clock-display:hover .clock,
#panel.hypede-shelf .panel-button.clock-display:checked .clock {
  box-shadow: none;
}
.hypede-tray-date,
.hypede-tray-clock {
  font-weight: 500;
  color: @fg@;
}
.hypede-tray-clock {
  padding-left: 6px;
}
#panel.hypede-shelf .panel-button .system-status-icon {
  icon-size: 16px;
  padding: 0;
  margin: 0 2px;
}
#panel.hypede-shelf .panel-status-indicators-box {
  spacing: 6px;
}

/* ------------------------------------------------------------------ */
/* Всплывающие «пузыри»: меню, быстрые настройки, календарь            */
/* ------------------------------------------------------------------ */

.popup-menu-boxpointer {
  -arrow-rise: 8px;
  -arrow-base: 0;
  -arrow-border-radius: 0;
}
.popup-menu.panel-menu {
  margin-bottom: 0;
  margin-top: 24px;
}
.popup-menu {
  color: @fg@;
}
.popup-menu-content {
  background-color: @bubble_bg@;
  border: 1px solid @bubble_border@;
  border-radius: 20px;
  padding: 8px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
  transition-duration: 200ms;
}
.popup-menu-item {
  border-radius: 10px;
  padding: 9px 12px;
  transition-duration: 100ms;
}
.popup-menu-item:hover,
.popup-menu-item:focus,
.popup-menu-item:selected {
  background-color: @hover@;
}
.popup-separator-menu-item .popup-separator-menu-item-separator {
  background-color: @separator@;
}

/* Быстрые настройки */
.quick-settings {
  padding: 16px;
  border-radius: 24px;
}
.quick-settings-grid {
  spacing-rows: 8px;
  spacing-columns: 8px;
}
.quick-toggle,
.quick-toggle-has-menu {
  border-radius: 20px;
  min-height: 3.6em;
}
.quick-toggle {
  color: @fg@;
  background-color: @tile_off@;
  box-shadow: none;
  transition-duration: 200ms;
}
.quick-toggle:hover {
  background-color: @tile_off_hover@;
}
.quick-toggle:checked {
  color: @tile_on_fg@;
  background-color: @tile_on@;
}
.quick-toggle:checked:hover {
  background-color: @tile_on_hover@;
}
.quick-toggle-has-menu .quick-toggle:ltr { border-radius: 20px 0 0 20px; }
.quick-toggle-has-menu .quick-toggle:rtl { border-radius: 0 20px 20px 0; }
.quick-toggle-has-menu .quick-toggle:ltr:last-child,
.quick-toggle-has-menu .quick-toggle:rtl:last-child { border-radius: 20px; }
.quick-toggle-has-menu .quick-toggle-menu-button:ltr { border-radius: 0 20px 20px 0; }
.quick-toggle-has-menu .quick-toggle-menu-button:rtl { border-radius: 20px 0 0 20px; }
.quick-toggle-has-menu .quick-toggle-menu-button {
  color: @fg@;
  background-color: @tile_off@;
  transition-duration: 200ms;
}
.quick-toggle-has-menu .quick-toggle-menu-button:hover {
  background-color: @tile_off_hover@;
}
.quick-toggle-has-menu .quick-toggle-menu-button:checked {
  color: @tile_on_fg@;
  background-color: @tile_on@;
}
.quick-toggle-menu {
  border-radius: 20px;
  background-color: @submenu_bg@;
  transition-duration: 150ms;
}
.quick-slider .slider {
  color: @slider@;
  -slider-height: 6px;
  -slider-background-color: @slider_track@;
  -slider-active-background-color: @slider@;
  -slider-handle-radius: 9px;
  -barlevel-height: 6px;
  -barlevel-background-color: @slider_track@;
  -barlevel-active-background-color: @slider@;
  transition-duration: 200ms;
}
.quick-settings .icon-button,
.quick-settings .button {
  background-color: @tile_off@;
  color: @fg@;
  transition-duration: 150ms;
}
.quick-settings .icon-button:hover,
.quick-settings .button:hover {
  background-color: @tile_off_hover@;
}

/* Плитки в духе Chrome OS (quicksettings.js): круг со значком, подпись
   под ним, три колонки. */
.quick-settings.hypede-chrome .quick-settings-grid {
  spacing-rows: 14px;
  spacing-columns: 4px;
}
.quick-settings .hypede-tile.quick-toggle,
.quick-settings .hypede-tile.quick-toggle-has-menu,
.quick-settings .hypede-tile .quick-toggle,
.quick-settings .hypede-tile .quick-toggle:hover,
.quick-settings .hypede-tile .quick-toggle:checked,
.quick-settings .hypede-tile.quick-toggle:hover,
.quick-settings .hypede-tile.quick-toggle:checked {
  background-color: transparent;
  color: @fg@;
  border-radius: 16px;
  min-height: 0;
  padding: 2px 0;
}
.quick-settings .hypede-tile .quick-toggle-icon {
  icon-size: 20px;
  padding: 14px;
  margin-bottom: 6px;
  border-radius: 999px;
  background-color: @tile_off@;
  color: @fg@;
  transition-duration: 150ms;
}
.quick-settings .hypede-tile .quick-toggle:hover .quick-toggle-icon,
.quick-settings .hypede-tile.quick-toggle:hover .quick-toggle-icon {
  background-color: @tile_off_hover@;
}
.quick-settings .hypede-tile .quick-toggle:checked .quick-toggle-icon,
.quick-settings .hypede-tile.quick-toggle:checked .quick-toggle-icon {
  background-color: @tile_on@;
  color: @tile_on_fg@;
}
.quick-settings .hypede-tile .quick-toggle:checked:hover .quick-toggle-icon,
.quick-settings .hypede-tile.quick-toggle:checked:hover .quick-toggle-icon {
  background-color: @tile_on_hover@;
}
.quick-settings .hypede-tile .quick-toggle-title {
  font-size: 9.5pt;
  font-weight: normal;
}
.quick-settings .hypede-tile .quick-toggle-subtitle {
  font-size: 8.5pt;
  color: @dim@;
}
.quick-settings .hypede-tile .hypede-tile-menu-button,
.quick-settings .hypede-tile .hypede-tile-menu-button:hover,
.quick-settings .hypede-tile .hypede-tile-menu-button:checked {
  background-color: transparent;
  color: @fg@;
  padding: 0 0 0 2px;
  min-width: 0;
  min-height: 0;
  border-radius: 999px;
}
.quick-settings .hypede-tile .hypede-tile-menu-button StIcon {
  icon-size: 16px;
}

/* Кнопка ИИ-помощника в строке поиска лаунчера */
.hypede-launcher-ask {
  icon-size: 20px;
  padding: 6px;
  border-radius: 999px;
  color: @accent_fg_on_surface@;
  transition-duration: 150ms;
}
.hypede-launcher-ask:hover {
  background-color: @chip_hover@;
}

/* Календарь и центр уведомлений */
.datemenu-popover,
#calendarArea {
  border-radius: 20px;
}
.calendar,
.datemenu-today-button,
.world-clocks-button,
.weather-button,
.events-button,
.message {
  border-radius: 16px;
}
.calendar-day:selected,
.calendar-today:selected {
  color: @tile_on_fg@;
  background-color: @tile_on@;
}

/* Баннеры уведомлений — в правом нижнем углу */
#notification-container {
  margin: 8px 8px 8px 8px;
}
#notification-container .message {
  background-color: @bubble_bg@;
  border: 1px solid @bubble_border@;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
  transition-duration: 200ms;
}

/* ------------------------------------------------------------------ */
/* Лаунчер                                                             */
/* ------------------------------------------------------------------ */

.hypede-launcher-menu .popup-menu-content {
  padding: 0;
  border-radius: 24px;
}

/* Полноэкранный лаунчер: без зазора от полки, без рамки и углов */
.hypede-launcher-menu.fullscreen {
  -arrow-rise: 0;
  -boxpointer-gap: 0;
}
.hypede-launcher-menu.fullscreen .popup-menu-content {
  border-radius: 0;
  border: none;
  box-shadow: none;
  background-color: @fullscreen_bg@;
}
.hypede-launcher.fullscreen {
  padding: 56px 48px 24px 48px;
  spacing: 28px;
}
.hypede-launcher.fullscreen .hypede-launcher-search {
  width: 600px;
  min-height: 48px;
  font-size: 12pt;
}
.hypede-launcher {
  width: 640px;
  padding: 16px 12px 12px 12px;
  spacing: 12px;
}
.hypede-launcher-search {
  min-height: 40px;
  padding: 0 16px;
  border-radius: 999px;
  border: none;
  font-size: 11pt;
  color: @fg@;
  background-color: @search_bg@;
  selection-background-color: @tile_on@;
  selected-color: @tile_on_fg@;
  caret-color: @fg@;
  box-shadow: none;
  transition-duration: 200ms;
}
.hypede-launcher-search:focus {
  background-color: @search_focus_bg@;
  box-shadow: inset 0 0 0 2px @focus_ring@;
}
.hypede-launcher-search StLabel.hint-text {
  color: @dim@;
}
.hypede-launcher-search-icon {
  icon-size: 18px;
  color: @dim@;
  padding-right: 10px;
}

.hypede-launcher-scroll {
  padding: 0 4px;
}
.hypede-launcher-section {
  spacing: 2px;
  padding-bottom: 8px;
}
.hypede-launcher-section-title {
  font-size: 9.5pt;
  font-weight: 500;
  color: @dim@;
  padding: 6px 12px 6px 12px;
}

/* «Продолжить с того же места» */
.hypede-launcher-continue {
  padding: 0 4px 4px 4px;
}
.hypede-launcher-chip {
  border-radius: 14px;
  padding: 10px 12px;
  background-color: @chip_bg@;
  transition-duration: 150ms;
}
.hypede-launcher-chip:hover,
.hypede-launcher-chip:focus {
  background-color: @chip_hover@;
}
.hypede-launcher-chip-box {
  spacing: 12px;
}
.hypede-launcher-chip-icon {
  color: @accent_fg_on_surface@;
}
.hypede-launcher-chip-title {
  font-size: 10pt;
  font-weight: 500;
}
.hypede-launcher-chip-subtitle {
  font-size: 9pt;
  color: @dim@;
}
.hypede-launcher-separator {
  height: 1px;
  margin: 8px 12px 12px 12px;
  background-color: @separator@;
}

/* Сетка приложений */
.hypede-launcher-grid {
  padding: 0 0 8px 0;
}
.hypede-launcher-app {
  width: 112px;
  padding: 10px 4px 8px 4px;
  border-radius: 16px;
  transition-duration: 150ms;
}
.hypede-launcher-app:hover {
  background-color: @hover@;
}
.hypede-launcher-app:focus {
  background-color: @hover@;
  box-shadow: inset 0 0 0 2px @focus_ring@;
}
.hypede-launcher-app-icon {
  padding-bottom: 8px;
}
.hypede-launcher-app.no-label .hypede-launcher-app-icon {
  padding-bottom: 0;
}
.hypede-launcher.fullscreen .hypede-launcher-app {
  padding: 14px 8px 12px 8px;
}
.hypede-launcher-app-label {
  font-size: 9.5pt;
  max-width: 100px;
  text-align: center;
  color: @fg@;
}

/* Результаты поиска */
.hypede-launcher-result {
  border-radius: 12px;
  padding: 8px 12px;
  transition-duration: 100ms;
}
.hypede-launcher-result:hover {
  background-color: @hover@;
}
.hypede-launcher-result:selected,
.hypede-launcher-result:focus {
  background-color: @result_selected@;
}
.hypede-launcher-result-box {
  spacing: 14px;
}
.hypede-launcher-result-icon StIcon {
  color: @dim@;
}
.hypede-launcher-result-title {
  font-size: 10.5pt;
  color: @fg@;
}
.hypede-launcher-result-subtitle {
  font-size: 9pt;
  color: @dim@;
}

/* ------------------------------------------------------------------ */
/* Обзор                                                               */
/* ------------------------------------------------------------------ */

.workspace-thumbnails .workspace-thumbnail {
  border-radius: 12px;
}
.workspace-thumbnail-indicator {
  border: 3px solid @focus_ring@;
  border-radius: 14px;
}
.window-caption {
  color: @tooltip_fg@;
  background-color: @tooltip_bg@;
  border-radius: 8px;
}

/* OSD громкости и яркости */
.osd-window {
  border-radius: 999px;
  background-color: @bubble_bg@;
  color: @fg@;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.28);
  transition-duration: 200ms;
}

/* ------------------------------------------------------------------ */
/* Экран блокировки                                                    */
/* ------------------------------------------------------------------ */
/* Одинаков в светлой и тёмной схеме: светлый текст на затемнённых
   размытых обоях. */

.hypede-lock-dim {
  background-color: rgb(8, 10, 14);
}

.hypede-lock-clock {
  spacing: 6px;
}
.hypede-lock-hours,
.hypede-lock-minutes,
.hypede-lock-colon {
  font-size: 150px;
  font-weight: 300;
  color: #ffffff;
  text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
  font-feature-settings: "tnum";
  transition-duration: 400ms;
}
.hypede-lock-colon {
  padding: 0 6px 22px 6px;
}
.hypede-lock-clock.stacked .hypede-lock-hours,
.hypede-lock-clock.stacked .hypede-lock-minutes {
  font-size: 118px;
  font-weight: 700;
}
.hypede-lock-clock.stacked .hypede-lock-minutes {
  color: st-mix(-st-accent-color, #ffffff, 45%);
}
.hypede-lock-analog {
  width: 300px;
  height: 300px;
  margin-bottom: 18px;
}
.hypede-lock-date {
  font-size: 20pt;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
}
.hypede-lock-hint {
  font-size: 11pt;
  color: rgba(255, 255, 255, 0.72);
}

/* Карточки */
.hypede-lock-card {
  width: 250px;
  padding: 18px 20px;
  spacing: 14px;
  color: #ffffff;
  background-color: rgba(20, 22, 28, 0.42);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24px;
  box-shadow: 0 8px 28px rgba(0, 0, 0, 0.25);
}
.hypede-lock-card-header {
  spacing: 10px;
}
.hypede-lock-card-icon {
  icon-size: 16px;
  color: st-mix(-st-accent-color, #ffffff, 55%);
}
.hypede-lock-card-title {
  font-size: 10.5pt;
  font-weight: 600;
}
.hypede-lock-row {
  spacing: 7px;
}
.hypede-lock-row-label {
  font-size: 9.5pt;
  color: rgba(255, 255, 255, 0.72);
}
.hypede-lock-row-value {
  font-size: 9.5pt;
  font-weight: 500;
  font-feature-settings: "tnum";
}
.hypede-lock-bar {
  height: 6px;
  border-radius: 999px;
  background-color: rgba(255, 255, 255, 0.14);
}
.hypede-lock-bar-fill {
  border-radius: 999px;
  background-color: st-mix(-st-accent-color, #ffffff, 65%);
}
.hypede-lock-bar.low .hypede-lock-bar-fill {
  background-color: #f28b82;
}
.hypede-lock-big {
  font-size: 42px;
  font-weight: 300;
  font-feature-settings: "tnum";
}
.hypede-lock-card-footnote {
  font-size: 9pt;
  color: rgba(255, 255, 255, 0.66);
}

/* Поле пароля GNOME — в духе Chrome OS: крупный аватар и «пилюля» */
.hypede-lock-dialog .login-dialog-prompt-entry,
.hypede-lock-dialog StPasswordEntry {
  border-radius: 999px;
  padding: 10px 18px;
  min-height: 24px;
  background-color: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  border: none;
  box-shadow: none;
  caret-color: #ffffff;
}
.hypede-lock-dialog .login-dialog-prompt-entry:focus,
.hypede-lock-dialog StPasswordEntry:focus {
  background-color: rgba(255, 255, 255, 0.2);
  box-shadow: inset 0 0 0 2px st-mix(-st-accent-color, #ffffff, 55%);
}
.hypede-lock-dialog .user-widget-label {
  font-size: 16pt;
  font-weight: 600;
  color: #ffffff;
}

/* ------------------------------------------------------------------ */
/* Приветствие при входе (greeting.js)                                 */
/* ------------------------------------------------------------------ */

.hypede-greeting {
  color: #ffffff;
  padding-bottom: 48px;
}
.hypede-greeting-title {
  font-size: 44pt;
  font-weight: 300;
}
.hypede-greeting-subtitle {
  font-size: 15pt;
  margin-top: 14px;
}
.hypede-greeting-hint {
  font-size: 10.5pt;
}

.hypede-lock-message {
  margin-top: 10px;
  font-size: 13pt;
  color: rgba(255, 255, 255, 0.80);
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
}
