<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="hypede">

  <!-- ================================================================ -->
  <!-- Оболочка: полка, лаунчер, анимации, экран блокировки              -->
  <!-- ================================================================ -->
  <schema id="dev.hypede.shell" path="/dev/hypede/shell/">

    <!-- Полка -->
    <key name="shelf-position" type="s">
      <choices>
        <choice value="bottom"/>
        <choice value="left"/>
        <choice value="right"/>
        <choice value="top"/>
      </choices>
      <default>'bottom'</default>
      <summary>Край экрана, у которого стоит полка</summary>
    </key>

    <key name="shelf-alignment" type="s">
      <choices>
        <choice value="center"/>
        <choice value="start"/>
      </choices>
      <default>'center'</default>
      <summary>Расположение значков на полке</summary>
      <description>center — по центру, как в Chrome OS; start — сразу после кнопки лаунчера.</description>
    </key>

    <key name="shelf-size" type="i">
      <range min="36" max="96"/>
      <default>52</default>
      <summary>Толщина полки в пикселях</summary>
    </key>

    <key name="shelf-icon-size" type="i">
      <range min="20" max="72"/>
      <default>36</default>
      <summary>Размер значков приложений на полке</summary>
    </key>

    <key name="shelf-style" type="s">
      <choices>
        <choice value="full"/>
        <choice value="floating"/>
      </choices>
      <default>'full'</default>
      <summary>Вид полки</summary>
      <description>full — во всю ширину края; floating — «островок» со скруглёнными углами и отступом от края.</description>
    </key>

    <!-- Цвета (темы). Пустая строка — цвет по умолчанию для светлой или
         тёмной схемы. Формат: #rrggbb. -->
    <key name="accent-custom" type="s">
      <default>''</default>
      <summary>Свой цвет акцента</summary>
      <description>Любой цвет вместо девяти акцентов GNOME. Оболочка, «Файлы» и «Настройки» берут его как есть, остальные приложения — ближайший акцент GNOME.</description>
    </key>
    <key name="shelf-color" type="s">
      <default>''</default>
      <summary>Цвет фона полки</summary>
    </key>
    <key name="launcher-color" type="s">
      <default>''</default>
      <summary>Цвет фона лаунчера, быстрых настроек и меню</summary>
    </key>
    <key name="theme-name" type="s">
      <default>''</default>
      <summary>Название последней применённой темы</summary>
    </key>

    <!-- Рабочий стол (apps/desktop, shell desktop.js) и живые обои. -->
    <key name="desktop-icons" type="b">
      <default>true</default>
      <summary>Значки на рабочем столе</summary>
      <description>Файлы из папки «Рабочий стол», как в KDE: перетаскивание в приложения и обратно, меню, переименование.</description>
    </key>
    <key name="desktop-icon-size" type="i">
      <range min="32" max="128"/>
      <default>64</default>
      <summary>Размер значков рабочего стола</summary>
    </key>
    <key name="desktop-show-home" type="b">
      <default>true</default>
      <summary>Значок домашней папки на рабочем столе</summary>
    </key>
    <key name="desktop-show-trash" type="b">
      <default>true</default>
      <summary>Значок корзины на рабочем столе</summary>
    </key>
    <key name="desktop-widgets" type="s">
      <default>'[{"type":"clock"},{"type":"weather"},{"type":"media"}]'</default>
      <summary>Виджеты на рабочем столе</summary>
      <description>JSON: список {type, x, y}; type — clock, calendar, weather, system, media, note. Без x/y виджет стоит в столбике у правого края.</description>
    </key>

    <key name="widget-note" type="s">
      <default>''</default>
      <summary>Текст заметки на рабочем столе</summary>
    </key>

    <key name="wallpaper-live" type="s">
      <default>''</default>
      <summary>Живые обои</summary>
      <description>Пусто — обычные обои. hypede:waves, hypede:aurora, hypede:bokeh, hypede:mesh — встроенные; file:// — своё видео или GIF.</description>
    </key>
    <key name="wallpaper-live-pause" type="b">
      <default>true</default>
      <summary>Останавливать живые обои под развёрнутыми окнами</summary>
    </key>
    <key name="wallpaper-live-speed" type="d">
      <range min="0.25" max="3.0"/>
      <default>1.0</default>
      <summary>Скорость встроенных живых обоев</summary>
    </key>

    <key name="clipboard-history" type="as">
      <default>['&lt;Super&gt;v']</default>
      <summary>История буфера обмена</summary>
    </key>
    <key name="float-window" type="as">
      <default>['&lt;Super&gt;z']</default>
      <summary>Плавающее окно поверх остальных</summary>
    </key>
    <key name="reopen-window" type="as">
      <default>['&lt;Super&gt;&lt;Shift&gt;t']</default>
      <summary>Вернуть закрытое окно</summary>
    </key>
    <key name="ask-selection" type="as">
      <default>['&lt;Super&gt;a']</default>
      <summary>Спросить ИИ о выделенном тексте</summary>
    </key>
    <key name="session-restore" type="s">
      <choices>
        <choice value="ask"/>
        <choice value="always"/>
        <choice value="never"/>
      </choices>
      <default>'ask'</default>
      <summary>Восстанавливать окна прошлого сеанса при входе</summary>
    </key>
    <key name="focus-modes" type="s">
      <default>'[{"id":"work","name":"","dnd":true,"power":"balanced","theme":"","apps":[]},{"id":"game","name":"","dnd":true,"power":"performance","theme":"","apps":["steam.desktop"]},{"id":"study","name":"","dnd":true,"power":"balanced","theme":"builtin:lagoon","apps":[]}]'</default>
      <summary>Режимы фокуса (JSON)</summary>
    </key>
    <key name="focus-mode" type="s">
      <default>''</default>
      <summary>Включённый режим фокуса</summary>
    </key>
    <key name="shelf-opacity" type="i">
      <range min="0" max="100"/>
      <default>80</default>
      <summary>Непрозрачность фона полки, %</summary>
    </key>

    <key name="shelf-blur" type="b">
      <default>true</default>
      <summary>Размывать то, что под полкой</summary>
    </key>

    <key name="shelf-autohide" type="b">
      <default>false</default>
      <summary>Автоматически скрывать полку</summary>
      <description>Полка уезжает за край, когда окно касается её, и выезжает при подводе указателя к краю.</description>
    </key>

    <key name="shelf-running-indicator" type="s">
      <choices>
        <choice value="dot"/>
        <choice value="line"/>
        <choice value="none"/>
      </choices>
      <default>'dot'</default>
      <summary>Как отмечать запущенные приложения</summary>
    </key>

    <key name="shelf-show-pinned" type="b">
      <default>true</default>
      <summary>Показывать закреплённые приложения</summary>
      <description>Если выключено, на полке остаются только запущенные приложения.</description>
    </key>

    <key name="shelf-hover-zoom" type="b">
      <default>false</default>
      <summary>Увеличивать значок под указателем</summary>
    </key>

    <key name="shelf-tooltips" type="b">
      <default>true</default>
      <summary>Подсказки с названиями приложений</summary>
    </key>

    <key name="show-date" type="b">
      <default>true</default>
      <summary>Показывать дату на полке</summary>
      <description>На вертикальной полке дата не показывается — для неё там нет места.</description>
    </key>

    <key name="minimize-to-shelf" type="b">
      <default>true</default>
      <summary>Сворачивать окна в значок на полке</summary>
      <description>Окно при сворачивании «улетает» в значок своего приложения.</description>
    </key>

    <!-- Лаунчер -->
    <key name="launcher-style" type="s">
      <choices>
        <choice value="bubble"/>
        <choice value="fullscreen"/>
      </choices>
      <default>'bubble'</default>
      <summary>Вид лаунчера</summary>
      <description>bubble — «пузырь» у угла полки; fullscreen — на весь экран поверх окон.</description>
    </key>

    <key name="launcher-columns" type="i">
      <range min="3" max="10"/>
      <default>5</default>
      <summary>Число колонок в сетке приложений лаунчера</summary>
      <description>В полноэкранном лаунчере колонок больше — столько, сколько помещается.</description>
    </key>

    <key name="launcher-icon-size" type="i">
      <range min="32" max="96"/>
      <default>48</default>
      <summary>Размер значков в лаунчере</summary>
    </key>

    <key name="launcher-show-labels" type="b">
      <default>true</default>
      <summary>Подписи под значками в лаунчере</summary>
    </key>

    <key name="launcher-sort" type="s">
      <choices>
        <choice value="alphabetical"/>
        <choice value="usage"/>
      </choices>
      <default>'alphabetical'</default>
      <summary>Порядок приложений в лаунчере</summary>
      <description>alphabetical — по алфавиту; usage — сначала те, что запускаются чаще.</description>
    </key>

    <key name="show-recent-files" type="b">
      <default>true</default>
      <summary>Показывать недавние файлы в лаунчере</summary>
      <description>Раздел «Продолжить с того же места» в лаунчере.</description>
    </key>

    <key name="launcher-search-providers" type="as">
      <default>['calculator', 'apps', 'settings', 'files', 'web']</default>
      <summary>Что искать в лаунчере</summary>
      <description>Возможные значения: calculator, apps, settings, files, web.</description>
    </key>

    <key name="launcher-hidden-apps" type="as">
      <default>['org.gnome.Settings.desktop', 'systemsettings.desktop', 'kdesystemsettings.desktop', 'org.gnome.Extensions.desktop', 'com.mattjakeman.ExtensionManager.desktop']</default>
      <summary>Приложения, скрытые в лаунчере</summary>
      <description>По умолчанию скрыты «Настройки» GNOME, «Параметры системы» KDE и менеджеры расширений GNOME: в HypeDE их заменяют «Настройки» HypeDE. Запускать их по-прежнему можно командой.</description>
    </key>

    <key name="launcher-opacity" type="i">
      <range min="40" max="100"/>
      <default>96</default>
      <summary>Непрозрачность фона лаунчера и меню, %</summary>
    </key>

    <key name="launcher-blur" type="b">
      <default>true</default>
      <summary>Размывать фон под лаунчером</summary>
    </key>

    <key name="web-search-url" type="s">
      <default>'https://www.google.com/search?q=%s'</default>
      <summary>Адрес поиска в интернете</summary>
      <description>%s заменяется поисковым запросом.</description>
    </key>

    <!-- Поведение и оформление -->
    <key name="super-key-action" type="s">
      <choices>
        <choice value="launcher"/>
        <choice value="overview"/>
      </choices>
      <default>'launcher'</default>
      <summary>Что открывает клавиша Super</summary>
      <description>launcher — лаунчер (как клавиша «Все» в Chrome OS); overview — обзор окон.</description>
    </key>

    <key name="lite-mode" type="b">
      <default>false</default>
      <summary>Лёгкий режим</summary>
      <description>Для слабых компьютеров: без размытия под полкой и лаунчером, без скругления окон шейдером, без волн на экране блокировки и приветствия.</description>
    </key>
    <key name="greeting" type="s">
      <choices>
        <choice value="always"/>
        <choice value="first"/>
        <choice value="never"/>
      </choices>
      <default>'always'</default>
      <summary>Приветствие при входе</summary>
      <description>always — при каждом входе; first — только при первом; never — не показывать.</description>
    </key>
    <key name="greeting-shown" type="b">
      <default>false</default>
      <summary>Приветствие уже показывалось</summary>
    </key>
    <key name="window-corners" type="b">
      <default>true</default>
      <summary>Скруглять углы окон</summary>
      <description>Окнам, которые не рисуют скругления и тень сами (Qt, Firefox, окна без рамки), HypeDE скругляет углы и добавляет тень.</description>
    </key>
    <key name="window-corner-radius" type="i">
      <range min="0" max="24"/>
      <default>12</default>
      <summary>Радиус скругления окон</summary>
    </key>
    <key name="window-animations" type="s">
      <choices>
        <choice value="hypede"/>
        <choice value="gnome"/>
      </choices>
      <default>'hypede'</default>
      <summary>Анимации окон</summary>
      <description>hypede — окна мягко вырастают и тают, как в Chrome OS; gnome — стандартные анимации GNOME.</description>
    </key>

    <key name="minimize-genie" type="b">
      <default>true</default>
      <summary>Сворачивание «джинном»</summary>
      <description>Окно сворачивается в значок на полке, перетекая в него.</description>
    </key>

    <key name="window-wobbly" type="b">
      <default>true</default>
      <summary>Желейные окна</summary>
      <description>При перетаскивании окно слегка изгибается и пружинит.</description>
    </key>

    <key name="touchpad-gestures" type="b">
      <default>true</default>
      <summary>Жесты четырьмя пальцами</summary>
      <description>Вверх — лаунчер, вниз — рабочий стол. Движение идёт за пальцами.</description>
    </key>

    <key name="animation-speed" type="d">
      <range min="0.25" max="3.0"/>
      <default>1.0</default>
      <summary>Скорость анимаций</summary>
      <description>Множитель скорости: 2 — вдвое быстрее, 0.5 — вдвое медленнее. Полностью анимации выключает ключ enable-animations в org.gnome.desktop.interface.</description>
    </key>

    <key name="corner-radius" type="i">
      <range min="0" max="32"/>
      <default>20</default>
      <summary>Скругление углов лаунчера, меню и уведомлений</summary>
    </key>

    <key name="notification-position" type="s">
      <choices>
        <choice value="bottom-right"/>
        <choice value="top-right"/>
        <choice value="top-center"/>
      </choices>
      <default>'bottom-right'</default>
      <summary>Где появляются всплывающие уведомления</summary>
    </key>

    <!-- Экран блокировки -->
    <key name="lock-style" type="s">
      <choices>
        <choice value="hypede"/>
        <choice value="gnome"/>
      </choices>
      <default>'hypede'</default>
      <summary>Экран блокировки</summary>
      <description>hypede — свой экран блокировки с большими часами и анимациями; gnome — стандартный.</description>
    </key>

    <key name="lock-clock-style" type="s">
      <choices>
        <choice value="digital"/>
        <choice value="stacked"/>
        <choice value="analog"/>
      </choices>
      <default>'digital'</default>
      <summary>Часы на экране блокировки</summary>
    </key>

    <key name="lock-intro-animation" type="b">
      <default>true</default>
      <summary>Волны при блокировке</summary>
      <description>Цветные волны прокатываются по экрану в момент блокировки.</description>
    </key>

    <key name="lock-show-cards" type="b">
      <default>true</default>
      <summary>Карточки на экране блокировки</summary>
      <description>Заряд, музыка и загрузка системы рядом с полем пароля.</description>
    </key>

    <key name="lock-blur" type="i">
      <range min="0" max="100"/>
      <default>60</default>
      <summary>Размытие обоев на экране блокировки, %</summary>
    </key>

    <key name="lock-wallpaper" type="s">
      <default>''</default>
      <summary>Обои экрана блокировки</summary>
      <description>URI картинки. Пустая строка — те же обои, что на рабочем столе.</description>
    </key>
    <key name="lock-clock-color" type="s">
      <default>''</default>
      <summary>Цвет часов на экране блокировки (#rrggbb, пусто — белый)</summary>
    </key>
    <key name="lock-clock-size" type="i">
      <range min="50" max="160"/>
      <default>100</default>
      <summary>Размер часов на экране блокировки, %</summary>
    </key>
    <key name="lock-message" type="s">
      <default>''</default>
      <summary>Надпись под датой на экране блокировки</summary>
    </key>
    <key name="lock-dim" type="i">
      <range min="0" max="90"/>
      <default>35</default>
      <summary>Затемнение обоев на экране блокировки, %</summary>
    </key>
  </schema>

  <!-- ================================================================ -->
  <!-- Сеанс: службы, автозапуск, расширения GNOME                        -->
  <!-- ================================================================ -->
  <schema id="dev.hypede.session" path="/dev/hypede/session/">
    <key name="optional-services" type="as">
      <default>['print-notifications', 'disk-health']</default>
      <summary>Необязательные службы GNOME, которые запускаются в HypeDE</summary>
      <description>Возможные значения: file-indexer, software-updates, calendar-alarms, remote-desktop, smartcard, usb-protection, mobile-broadband, disk-health, print-notifications. Изменения вступают в силу при следующем входе.</description>
    </key>

    <key name="disabled-autostart" type="as">
      <default>['baloo_file', 'org.gnome.Evolution-alarm-notify', 'localsearch-3', 'geoclue-demo-agent', 'org.gnome.Software', 'gnome-software-service']</default>
      <summary>Программы автозапуска, которые не запускаются в HypeDE</summary>
      <description>Имена .desktop-файлов из каталогов автозапуска без расширения. В обычном GNOME они запускаются как прежде.</description>
    </key>

    <key name="allow-gnome-extensions" type="b">
      <default>false</default>
      <summary>Разрешить расширения GNOME</summary>
      <description>По умолчанию в сеансе HypeDE работают только его собственные компоненты: расширения, включённые для обычного GNOME, сюда не попадают.</description>
    </key>

    <key name="imported-from-gnome" type="b">
      <default>false</default>
      <summary>Настройки GNOME уже перенесены</summary>
      <description>При первом входе HypeDE переносит из обычного GNOME раскладки, настройки мыши, клавиатуры и специальных возможностей.</description>
    </key>
  </schema>

  <!-- ================================================================ -->
  <!-- «Настройки» HypeDE                                               -->
  <!-- ================================================================ -->
  <schema id="dev.hypede.settings" path="/dev/hypede/settings/">
    <key name="show-support-card" type="b">
      <default>true</default>
      <summary>Показывать карточку поддержки проекта</summary>
    </key>
  </schema>

  <!-- ИИ-помощник (apps/assistant). Выключен, пока его не включат в
       «Настройках»: без этого нигде нет кнопок «Спросить…». -->
  <schema id="dev.hypede.assistant" path="/dev/hypede/assistant/">
    <key name="enabled" type="b">
      <default>false</default>
      <summary>ИИ-помощник включён</summary>
    </key>
    <key name="provider" type="s">
      <choices>
        <choice value="claude"/>
        <choice value="gemini"/>
        <choice value="mistral"/>
        <choice value="chatgpt"/>
        <choice value="grok"/>
        <choice value="deepseek"/>
      </choices>
      <default>'claude'</default>
      <summary>Провайдер</summary>
      <description>Чей чат открывает помощник. Вход — в собственную учётную запись на сайте провайдера.</description>
    </key>
    <key name="panel-width" type="i">
      <range min="320" max="900"/>
      <default>440</default>
      <summary>Ширина панели помощника</summary>
    </key>
  </schema>
</schemalist>
