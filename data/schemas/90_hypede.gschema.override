# Значения по умолчанию для сеанса HypeDE.
#
# Секции с суффиксом «:HypeDE» действуют только там, где XDG_CURRENT_DESKTOP
# содержит HypeDE, то есть только в нашем сеансе. Обычный сеанс GNOME на той
# же машине остаётся нетронутым.

[org.gnome.desktop.interface:HypeDE]
enable-hot-corners=false
font-name='Roboto 11'
document-font-name='Roboto 11'
clock-show-weekday=false
clock-show-date=false
accent-color='blue'
# Значки в стиле Chrome OS (Material Symbols), остальное — из Adwaita.
icon-theme='HypeDE'

[org.gnome.desktop.wm.preferences:HypeDE]
button-layout='appmenu:minimize,maximize,close'
titlebar-font='Roboto Medium 11'

[org.gnome.desktop.background:HypeDE]
picture-uri='file:///usr/share/hypede/wallpapers/horizon-light.svg'
picture-uri-dark='file:///usr/share/hypede/wallpapers/horizon-dark.svg'
picture-options='zoom'

[org.gnome.desktop.sound:HypeDE]
theme-name='hypede'
event-sounds=true

[org.gnome.desktop.screensaver:HypeDE]
picture-uri='file:///usr/share/hypede/wallpapers/horizon-dark.svg'

[org.gnome.mutter:HypeDE]
center-new-windows=true
edge-tiling=true
dynamic-workspaces=true

[org.gnome.shell:HypeDE]
favorite-apps=['org.chromium.Chromium.desktop', 'chromium.desktop', 'google-chrome.desktop', 'firefox.desktop', 'dev.hypede.Files.desktop', 'org.gnome.Console.desktop', 'org.gnome.TextEditor.desktop', 'dev.hypede.Settings.desktop']

[org.gnome.shell.keybindings:HypeDE]
toggle-message-tray=['<Super>m']
toggle-application-view=[]

# Динамический остров (DynamicLinux) в духе Chrome OS: живёт на полке, а не
# вместо верхней панели; открывается щелчком; уведомления остаются у HypeDE;
# лаунчер и калькулятор — свои, поэтому этих вкладок у острова нет.
[org.gnome.shell.extensions.dynamic-island]
replace-panel=false
reserve-space=false
hover-expand=false
island-notifications=false
compact-width=200
compact-layout='{"media":"left","pet":"left","clock":"hidden","weather":"right","cpu":"hidden","fps":"hidden","ram":"hidden","temp":"hidden","net":"hidden","battery":"hidden","date":"hidden","keyboard":"hidden"}'
enabled-tabs=['home', 'clipboard', 'shelf', 'ai', 'tools', 'text', 'notes', 'system', 'weather', 'timer', 'pet', 'settings']
