[Desktop Entry]
Name=HypeDE
Comment=A desktop in the style of Chrome OS: shelf, launcher and quick settings
Comment[ru]=Рабочий стол в стиле Chrome OS: полка, лаунчер и быстрые настройки
Exec=@LIBEXECDIR@/hypede-session
TryExec=@LIBEXECDIR@/hypede-session
Type=Application
DesktopNames=HypeDE;GNOME;
X-GDM-SessionRegisters=true
X-GDM-CanRunHeadless=true
