#!/bin/sh
# Вызывается при выходе из сеанса HypeDE (hypede-session.service).
# Убирает из окружения systemd пользователя переменные, выставленные
# hypede-session, и каталог оболочки HypeDE из XDG_DATA_DIRS.
data_dirs=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^XDG_DATA_DIRS=//p')
cleaned=$(printf '%s' "$data_dirs" | tr ':' '\n' | grep -vxF '@SHELLDATADIR@' | paste -sd: -)
systemctl --user unset-environment DCONF_PROFILE HYPEDE_SESSION XDG_CURRENT_DESKTOP
if [ -n "$cleaned" ]; then
    systemctl --user set-environment "XDG_DATA_DIRS=$cleaned"
else
    systemctl --user unset-environment XDG_DATA_DIRS
fi
# Каталог с цветами KDE в тон HypeDE — тоже только для сеанса HypeDE.
config_dirs=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^XDG_CONFIG_DIRS=//p')
config_cleaned=$(printf '%s' "$config_dirs" | tr ':' '\n' | grep -v '/hypede/xdg$' | paste -sd: -)
if [ -n "$config_cleaned" ]; then
    systemctl --user set-environment "XDG_CONFIG_DIRS=$config_cleaned"
else
    systemctl --user unset-environment XDG_CONFIG_DIRS
fi
# Порталы читали базу настроек HypeDE — следующий сеанс запустит свои.
systemctl --user stop xdg-desktop-portal.service \
    xdg-desktop-portal-gnome.service xdg-desktop-portal-gtk.service
exit 0
